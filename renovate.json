{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": false,
  "automergeStrategy": "rebase",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Group non-major npm/bun updates into a single PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    {
      "description": "Group GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Automerge non-major updates once CI passes; majors wait for review",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Update the pinned bun version in package.json (packageManager) and mise.toml together",
      "matchDepNames": ["bun"],
      "groupName": "bun"
    },
    {
      "description": "Keep @types/node on the major matching the pinned Node LTS (mise.toml: node 26); bump this cap when the Node version is raised",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<27"
    },
    {
      "description": "Bump Node in mise.toml, CI and netlify.toml in a single PR",
      "matchDepNames": ["node"],
      "groupName": "node"
    }
  ],
  "customManagers": [
    {
      "description": "Keep Netlify's NODE_VERSION in step with mise.toml and CI",
      "customType": "regex",
      "managerFilePatterns": ["/^netlify\\.toml$/"],
      "matchStrings": ["NODE_VERSION = \"(?<currentValue>\\d+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ]
}
