/node_modules
/dist/
/coverage/
*.~undo-tree~
.DS_Store
*.tsbuildinfo
.serena/
/docs/superpowers/

# Local env files (per-developer, not for publishing)
.env*.local

# Claude Code: shared settings.json is committed; local overrides stay per-developer
.claude/settings.local.json

# Beads: tracked files (config, issues.jsonl, skills) are shared; the
# local DB, runtime state, and credential key stay ignored via .beads/.gitignore
# interactions.jsonl is a per-machine audit log — churns constantly, not shared
.beads/interactions.jsonl
# Runtime files bd leaves outside .beads/.gitignore's patterns
.beads.gate.lock
.beads/dolt-server-config.yaml

# Dolt database files (added by bd init)
.dolt/
*.db

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
